# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/

# Tool caches
.eslintcache
.stylelintcache
.prettiercache

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# System Files
.DS_Store
Thumbs.db

# IDEs
.idea/
.vscode/*
!.vscode/settings.json

# Generated Data & Pipeline Artifacts
dist/
# Publicado pelo build a partir do CSS de página em src/**/styles/; varia por
# publicação, então fica fora do git (ao contrário de site/assets/img/, que é a
# união estável de todas as publicações e é versionada para site/ ser deployável).
site/assets/css/generated/
site/JSON/*.json
site/JSON/*.series.bin
site/GeoJSON/*.geojson
site/GeoJSON/*.json
# Distribuições observadas da estação: derivadas do acervo de sensores do
# laboratório, que não é público. Como as saídas do WRF, chegam pelo deploy.
site/Climatologia/*.json
# Janela móvel de 7 dias do monitoramento, reescrita a cada hora pelo deploy.
# Mesma origem e mesma restrição do diretório acima: é o registro bruto da
# estação, não um produto publicável.
site/Monitoramento/*.json
# Quadros da câmera all-sky, a máscara segmentada prevista sobre eles e o payload
# do gráfico Kt × Kd. Regra por diretório, e não por extensão: aqui chegam imagens
# além de JSON. O .keep segue rastreado para o diretório existir sem os dados.
site/Ceu/*
!site/Ceu/.keep

# Onboarding deck (docs/) — versiona a fonte e o PDF; ignora gerados/pesados.
# node_modules/ e dist/ (assets/dist) já caem nas regras acima.
*.pptx
docs/onboarding-architecture/assets/theme-previews/
# Capturas do build local usadas no tour dos módulos: são imagens pesadas e
# derivadas do site já renderizado. O PDF exportado carrega o tour; a fonte
# das capturas é o próprio build, recapturado quando a interface muda.
docs/onboarding-architecture/public/module-tour/

# Environment variables
.env
.env.local
.env.*
