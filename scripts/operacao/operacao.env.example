# Configuração das rotinas de operação do site. Copie para operacao.env (fora do
# git) e ajuste ao servidor. É um arquivo de shell: lido com `.` por comum.sh.

# Checkout do micrometeorology: as tabelas do datalogger chegam em data/ e o
# acervo recente é montado em output/.
MICRO_DIR=/caminho/para/micrometeorology
# bin/ do ambiente com o micrometeorology instalado (`make install-dev` lá).
MICRO_BIN=/caminho/para/conda/envs/micrometeorology/bin

# Diretório site/ que recebe os dados. Vazio: o site/ deste checkout, que é onde
# o build espera JSON/, GeoJSON/, Climatologia/, Monitoramento/ e Ceu/.
SITE_DIR=

# Série operacional do WRF, acrescentada uma vez por dia pelo mm-wrf-series:
# a camada do modelo no Monitoramento.
SERIE_WRF=/caminho/para/labmim_series_operacional.dat

# Logs por dia (AAAAMMDD-site-*.log) e travas das execuções.
LOG_DIR=/caminho/para/logs
# Dias de log guardados; os mais antigos são apagados pelas próprias rotinas.
LOG_DIAS=30

# PC da estação (Windows com OpenSSH Server; ver README.md). O IP muda a cada
# reinício, então o PC é achado pelo nome: primeiro mDNS, depois NetBIOS.
ESTACAO_HOST=pc-da-estacao.local
ESTACAO_NETBIOS=PC-DA-ESTACAO
ESTACAO_USUARIO=usuario_da_copia
ESTACAO_CHAVE=$HOME/.ssh/chave_da_estacao_ed25519
# Pasta das tabelas no Windows, no formato do SFTP do OpenSSH (/E:/pasta).
ESTACAO_ORIGEM=/E:/pasta/do/loggernet
# Tabelas que o logger está gravando agora. Troque quando o programa do logger
# mudar e começar arquivos novos.
TABELA_LENTA=LBM_lenta_2025.dat
TABELA_RAIN=LBM_rain_2025.dat

# Câmera all-sky: onde o allsky-watch grava as imagens e o DINOv3 que o modelo usa.
ALLSKY_SERVING=configs/allsky/serving/ceu.yaml
ALLSKY_WATCH_DIR=$HOME/labmim/allsky-watch/ceuv3res512
ALLSKY_DINOV3_REPO=$HOME/labmim/dinov3/repo
ALLSKY_DINOV3_WEIGHTS=$HOME/labmim/dinov3/dinov3_vits16plus_pretrain_lvd1689m.pth
