# Apache configuration shared by every WebGIS publication: only the legacy
# redirects vary per publication (they come from the manifest). Every directive
# is guarded by <IfModule> so the site never answers 500 where a module is
# missing — which also means this whole layer disappears silently on a host
# without AllowOverride. Confirm the host before relying on the CSP or the
# redirects here.

AddDefaultCharset UTF-8

ErrorDocument 404 /404.html

# Each publication declares only its own aliases in the manifest.
<IfModule mod_alias.c>
{{LEGACY_REDIRECTS}}
</IfModule>

<IfModule mod_mime.c>
  AddType application/json .json
  AddType application/geo+json .geojson
</IfModule>

# The forecast payloads run from hundreds of KB to several MB, so compression is
# the site's largest transfer win. On Apache 2.4 AddOutputFilterByType belongs to
# mod_filter, hence the double guard.
<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/geo+json
    AddOutputFilterByType DEFLATE image/svg+xml
  </IfModule>
</IfModule>

# Brotli when available; clients without it still get gzip from the block above.
<IfModule mod_brotli.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html
    AddOutputFilterByType BROTLI_COMPRESS text/css
    AddOutputFilterByType BROTLI_COMPRESS application/javascript
    AddOutputFilterByType BROTLI_COMPRESS text/javascript
    AddOutputFilterByType BROTLI_COMPRESS application/json
    AddOutputFilterByType BROTLI_COMPRESS application/geo+json
    AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
  </IfModule>
</IfModule>

<IfModule mod_headers.c>
  # `always` so these reach error responses too.
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"

  # Every CSS/JS file is same-origin (vendored) and no inline script is
  # executable, so script-src stays 'self'; 'unsafe-inline' in style-src covers
  # only style attributes (Leaflet, style="display:none"). data: in img-src is
  # the favicon and the navbar-toggler icon, the OSM hosts are the map tiles,
  # frame-src is the Google Maps iframe.
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://tile.openstreetmap.org https://*.tile.osm.org https://*.tile.openstreetmap.org; font-src 'self'; connect-src 'self'; frame-src https://www.google.com; upgrade-insecure-requests"

  # The pipeline REUSES the same file names on every run, so the browser may
  # never trust an old copy without revalidating. The .bin series are kept OUT of
  # the compression lists above on purpose: mod_deflate does not compress 206
  # responses, and a compressed body would defeat the partial reads (Range,
  # ~300B) the site makes on those files.
  <FilesMatch "\.(json|geojson|bin)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # The app already cache-busts CSS/JS through ?v=, so a short window suffices.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600, stale-while-revalidate=86400"
  </FilesMatch>

  <FilesMatch "\.(png|jpe?g|gif|webp|svg|ico|woff2?|ttf)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # Vendored libraries are versioned at deploy time and immutable. EXCEPTION:
  # fa-solid-900.woff2 is a regenerable SUBSET — its content changes without the
  # URL changing — so it stays on the 7-day font rule above.
  <If "%{REQUEST_URI} =~ m#^/assets/vendor/# && %{REQUEST_URI} !~ m#^/assets/vendor/fontawesome/webfonts/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  # Monitoring charts: regenerated under the SAME file name by the station.
  <If "%{REQUEST_URI} =~ m#^/assets/graphs/#">
    Header set Cache-Control "no-cache"
  </If>

  # On our own assets ?v= is a content hash stamped by build.js, so the URL
  # changes whenever the content does. <If> blocks apply last when the
  # configuration is merged, which is what lets this override the short CSS/JS
  # rule. Web Workers are included: without the labmim-asset-hashes meta tag
  # their URL comes out with no ?v= and falls back to that short rule.
  <If "%{QUERY_STRING} =~ /(^|&)v=/ && %{REQUEST_URI} =~ m#\.(css|js)$#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  # Versioned forecast data: 24h rather than a year, so the ceiling limits the
  # damage if an orphan manifest stays published (a pipeline rollback that writes
  # no manifest while the data is swapped under the same names). Runs are daily.
  <If "%{QUERY_STRING} =~ /(^|&)v=/ && %{REQUEST_URI} =~ m#\.(json|geojson|bin)$#">
    Header set Cache-Control "public, max-age=86400"
  </If>
</IfModule>
